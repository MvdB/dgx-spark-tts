# Chatterbox Multilingual V3 auf DGX Spark (GB10, aarch64).
# Basis: das Qwen3-TTS-Image — dort sind NGC-torch UND das aus Source
# gebaute torchaudio bereits vorhanden. chatterbox-tts pinnt torch/torchaudio
# teils exakt, daher --no-deps + manuelle Abhängigkeiten mit Guard.
FROM spark-qwen3-tts:v1

RUN pip install --no-cache-dir --no-deps chatterbox-tts \
    && pip install --no-cache-dir librosa s3tokenizer resemble-perth conformer \
       "diffusers>=0.29" safetensors pkuseg spacy-pkuseg pykakasi \
    && python3 -c "import torch, torchaudio; assert torch.version.cuda; \
import torchaudio._extension.utils as u; u._check_cuda_version(); \
from chatterbox.mtl_tts import ChatterboxMultilingualTTS; print('Import OK')"

COPY server_chatterbox.py /opt/chatterbox/server.py

EXPOSE 8003
ENTRYPOINT ["python3", "/opt/chatterbox/server.py"]
